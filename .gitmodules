[submodule "lib/uniswap-hooks"]
	path = lib/uniswap-hooks
	url = https://github.com/OpenZeppelin/uniswap-hooks
[submodule "lib/forge-std"]
	path = lib/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "aqua/lib/forge-std"]
	path = aqua/lib/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "aqua/lib/openzeppelin-contracts"]
	path = aqua/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "aqua/lib/solidity-utils"]
	path = aqua/lib/solidity-utils
	url = https://github.com/1inch/solidity-utils
[submodule "aqua/lib/swap-vm"]
	path = aqua/lib/swap-vm
	url = https://github.com/1inch/swap-vm
[submodule "aqua/lib/aqua"]
	path = aqua/lib/aqua
	url = https://github.com/1inch/aqua
