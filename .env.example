# Copy to .env and fill in. .env is git-ignored; never commit it or paste a key into argv.

# Robinhood Chain RPCs (public defaults work; a private endpoint is faster).
RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc

# Testnet 46630 deployer key, read by script/*.s.sol via vm.envUint. Leave empty unless deploying.
# The scripts refuse any chain other than 46630.
HAKARI_DEPLOYER_KEY=

# Optional: Δ (max ticks per observation) for a new hook deployment. Default in script/Deploy.s.sol.
# HAKARI_DELTA=250
