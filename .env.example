# Copy to .env and fill in. .env is git-ignored and is never read or printed by the AI (AGENTS.md).

# Robinhood Chain mainnet 4663 — READ ONLY. Nothing in this repo broadcasts here.
# One URL or several, comma-separated: the gauge rotates across them and keeps the public endpoint as the last
# fallback. Every URL is checked to answer chain id 4663 before use; URLs are never printed.
RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com

# Robinhood Chain testnet 46630 — where the hook and lens are deployed for real.
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc

# Deployer key for 46630 only. Read by `forge script` through the environment; never passed on argv.
# Both deploy scripts require chain id 46630 whatever the RPC variable says.
HAKARI_DEPLOYER_KEY=
