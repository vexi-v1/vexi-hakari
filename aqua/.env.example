# Copy to .env and fill in. Never commit .env.

# Robinhood Chain mainnet (chain id 4663). READ-ONLY: only ever used as the fork source for the tests.
# It must serve historical state at RH_MAINNET_FORK_BLOCK (an archive endpoint). The official public endpoint
# https://rpc.mainnet.chain.robinhood.com keeps only minutes of state; https://rpc.ordofi.network served the pinned
# block during the event. Never send a transaction to this endpoint.
RH_MAINNET_RPC=

# Block to fork 4663 at. Pinned so every run sees the same pools, balances and routers.
RH_MAINNET_FORK_BLOCK=72248228

# Robinhood Chain testnet (chain id 46630), for script/DeployBand.s.sol only.
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc
# The key that deploys the band on 46630. Read by forge from the environment; never passed on argv.
BAND_DEPLOYER_KEY=
